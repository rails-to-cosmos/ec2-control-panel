{
  "uid": "ec2cp-costs",
  "title": "EC2 sandbox costs",
  "tags": ["ec2cp"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "owner",
        "label": "User",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(ec2cp_instance_cost_usd_total, owner)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Spend per hour, by user",
      "description": "Approximate cost accrued per hour, summed over each user's instances.",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" }, "lineWidth": 1 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (owner) (increase(ec2cp_instance_cost_usd_total{owner=~\"$owner\"}[1h]))",
          "legendFormat": "{{owner}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "Share of spend (range)",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "legend": { "displayMode": "table", "values": ["value"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (owner) (increase(ec2cp_instance_cost_usd_total{owner=~\"$owner\"}[$__range]))",
          "legendFormat": "{{owner}}",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Burn rate now",
      "description": "Sum of the hourly rate of everything currently running.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 3 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(ec2cp_instance_hourly_usd{owner=~\"$owner\"})", "instant": true }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Spend over range",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ec2cp_instance_cost_usd_total{owner=~\"$owner\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Instances running",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(ec2cp_instance_running{owner=~\"$owner\"})", "instant": true }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Running hours over range",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "h", "decimals": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ec2cp_instance_running_seconds_total{owner=~\"$owner\"}[$__range])) / 3600",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Per instance over range",
      "description": "Cost, running hours and launches for each instance in the selected window.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "cost" }, "properties": [{ "id": "unit", "value": "currencyUSD" }, { "id": "decimals", "value": 2 }] },
          { "matcher": { "id": "byName", "options": "hours" }, "properties": [{ "id": "unit", "value": "h" }, { "id": "decimals", "value": 1 }] }
        ]
      },
      "transformations": [
        { "id": "joinByField", "options": { "byField": "instance", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Time 1": true, "Time 2": true, "Time 3": true },
            "renameByName": { "Value #A": "cost", "Value #B": "hours", "Value #C": "launches" }
          }
        },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "cost", "desc": true }] } }
      ],
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "sum by (instance, owner) (increase(ec2cp_instance_cost_usd_total{owner=~\"$owner\"}[$__range]))"
        },
        {
          "refId": "B",
          "format": "table",
          "instant": true,
          "expr": "sum by (instance) (increase(ec2cp_instance_running_seconds_total{owner=~\"$owner\"}[$__range])) / 3600"
        },
        {
          "refId": "C",
          "format": "table",
          "instant": true,
          "expr": "sum by (instance) (increase(ec2cp_instance_sessions_total{owner=~\"$owner\"}[$__range]))"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Instance type and purchase model in use",
      "description": "One line per running instance, labelled with the type it is running as.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "custom": { "lineWidth": 1, "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "ec2cp_instance_hourly_usd{owner=~\"$owner\"} > 0",
          "legendFormat": "{{instance}} — {{type}} ({{model}})"
        }
      ]
    }
  ]
}
